# Unity generated data (also supports a Unity project in a subdirectory).
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/
**/Assets/AssetStoreTools*

# Generated IDE projects and local editor state.
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports and local build outputs.
sysinfo.txt
*.apk
*.aab
*.unitypackage
crashlytics-build.properties

# Blender backups; keep source .blend files and exported assets tracked.
*.blend[0-9]*
*.blend@

# OS files and local secrets.
.DS_Store
._*
Thumbs.db
Desktop.ini
.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]

# Keep Assets (including .meta files), Packages, and ProjectSettings tracked.

# Large Drive-backed payloads; their manifest and Unity identities remain in Git.
/external-assets/
/.asset-state.json
/.asset-release.json
/Unity/Assets/External/**
!/Unity/Assets/External/**/
!/Unity/Assets/External/**/*.meta

# Teknologidagen lake meshes and textures (about 140 MB), rebuilt by TAC/Teknologidagen/Upgrade lake,
# which runs by itself when the scene opens without them.
/Unity/Assets/TacSim/Art/Structure/Split/
/Unity/Assets/TacSim/Art/Structure/Split.meta
/Unity/Assets/TacSim/Art/Teknologidagen/Generated/
/Unity/Assets/TacSim/Art/Teknologidagen/Generated.meta
